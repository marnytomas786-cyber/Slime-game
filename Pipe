using System.Collections;
using UnityEngine;

public class BurstPipe : MonoBehaviour
{
    [SerializeField] private float startDelay = 0f;
    [SerializeField] private float idleTime = 4f;
    [SerializeField] private float warningTime = 1.5f;
    [SerializeField] private float burstTime = 3f;
    [SerializeField] private float jetLength = 6f;
    [SerializeField] private float jetWidth = 1.5f;
    [SerializeField] private float pushAcceleration = 40f;
    [SerializeField] private int damage = 1;

    private ParticleSystem waterParticles;
    private Vector3 basePosition;
    private bool bursting;

    private void Start()
    {
        basePosition = transform.localPosition;

        GameObject particleObj = new GameObject("WaterJetParticles");
        particleObj.transform.SetParent(transform, false);
        particleObj.transform.localPosition = Vector3.zero;
        particleObj.transform.localRotation = Quaternion.identity;

        waterParticles = particleObj.AddComponent<ParticleSystem>();
        
        var main = waterParticles.main;
        main.startLifetime = 0.5f;
        main.startSpeed = jetLength * 2f;
        main.startSize = 0.4f;
        main.startColor = new Color32(100, 180, 255, 200);
        main.simulationSpace = ParticleSystemSimulationSpace.World;
        main.maxParticles = 300;

        var emission = waterParticles.emission;
        emission.rateOverTime = 150f;

        var shape = waterParticles.shape;
        shape.shapeType = ParticleSystemShapeType.Cone;
        shape.angle = 5f;
        shape.radius = jetWidth * 0.3f;

        waterParticles.Stop();
        StartCoroutine(Cycle());
    }

    private void OnDestroy()
    {
        if (waterParticles != null)
            Destroy(waterParticles.gameObject);
    }

    private IEnumerator Cycle()
    {
        yield return new WaitForSeconds(startDelay);

        while (true)
        {
            yield return new WaitForSeconds(idleTime);

            for (float t = 0f; t < warningTime; t += Time.deltaTime)
            {
                float p = t / warningTime;
                transform.localPosition = basePosition + Random.insideUnitSphere * 0.03f * p;
                yield return null;
            }

            transform.localPosition = basePosition;
            
            bursting = true;
            waterParticles.Play();

            yield return new WaitForSeconds(burstTime);

            bursting = false;
            waterParticles.Stop();
        }
    }

    private void FixedUpdate()
    {
        if (!bursting)
            return;

        Vector3 center = transform.position + transform.forward * jetLength * 0.5f;
        Vector3 halfSize = new Vector3(jetWidth, jetWidth, jetLength) * 0.5f;

        foreach (Collider hit in Physics.OverlapBox(center, halfSize, transform.rotation, ~0, QueryTriggerInteraction.Ignore))
        {
            SlimeHealth health = hit.GetComponentInParent<SlimeHealth>();
            if (health == null || health.IsDead)
                continue;

            Rigidbody rb = health.GetComponent<Rigidbody>();
            if (rb != null)
            {
                rb.AddForce(transform.forward * pushAcceleration, ForceMode.Acceleration);
            }
            health.Damage(damage);
        }
    }

    private void OnDrawGizmosSelected()
    {
        Gizmos.color = Color.cyan;
        Gizmos.matrix = Matrix4x4.TRS(transform.position + transform.forward * jetLength * 0.5f, transform.rotation, Vector3.one);
        Gizmos.DrawWireCube(Vector3.zero, new Vector3(jetWidth, jetWidth, jetLength));
    }
}
