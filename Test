using UnityEngine;
using UnityEngine.InputSystem;
using UnityEngine.Serialization;

#if UNITY_6000_0_OR_NEWER
using SlimePhysicsMaterial = UnityEngine.PhysicsMaterial;
using SlimePhysicsMaterialCombine = UnityEngine.PhysicsMaterialCombine;
#else
using SlimePhysicsMaterial = UnityEngine.PhysicMaterial;
using SlimePhysicsMaterialCombine = UnityEngine.PhysicMaterialCombine;
#endif

[DisallowMultipleComponent]
[RequireComponent(typeof(Rigidbody))]
public class SlimeLauncher : MonoBehaviour
{
    [Header("Pohyb")]
    [Min(0f)] public float moveSpeed = 6f;
    [Min(0f)] public float acceleration = 40f;
    [Min(1f)] public float rotationSpeed = 720f;

    [Header("Skok")]
    [Min(0f)] public float jumpPower = 8f;
    [Min(0.01f)] public float chargeTime = 1f;
    [Range(0f, 1f)] public float minimumJumpCharge = 0.3f;

    [Header("Odraz")]
    [Tooltip("Kolik z celkove rychlosti zustane po odrazu. 0.75 = ztrata 1/4 rychlosti.")]
    [Range(0f, 1f)] public float bounciness = 0.75f;
    [Min(0f)] public float minimumFloorImpactSpeed = 2f;
    [Min(0f)] public float minimumWallImpactSpeed = 0.5f;
    [FormerlySerializedAs("wallBounceControlLock")]
    [Tooltip("Na kratkou dobu po odrazu pozastavi rizeni, aby se odraz ihned neprepsal pohybem.")]
    [Min(0f)] public float bounceControlLock = 0.18f;

    [Header("Pojistka")]
    public float fallLimit = -30f;
    [Min(0.01f)] public float maximumFallSpeed = 50f;

    private Rigidbody rb;
    private Collider groundCheckCollider;
    private Camera mainCamera;
    private SlimePhysicsMaterial runtimePhysicsMaterial;

    private Vector3 startPosition;
    private Quaternion startRotation;
    private Vector3 moveDirection;
    private Vector3 lastVelocity;

    private float charge;
    private float pendingJump;
    private float bounceControlLockTimer;
    private bool charging;

    // Unity 6 renamed velocity/drag and PhysicMaterial APIs.
    // These wrappers keep one script usable in Unity 6 and older supported versions.
    private Vector3 LinearVelocity
    {
        get
        {
#if UNITY_6000_0_OR_NEWER
            return rb.linearVelocity;
#else
            return rb.velocity;
#endif
        }
        set
        {
#if UNITY_6000_0_OR_NEWER
            rb.linearVelocity = value;
#else
            rb.velocity = value;
#endif
        }
    }

    private void Awake()
    {
        rb = GetComponent<Rigidbody>();

        rb.isKinematic = false;
        rb.useGravity = true;
#if UNITY_6000_0_OR_NEWER
        rb.linearDamping = 0f;
        rb.angularDamping = 0.05f;
#else
        rb.drag = 0f;
        rb.angularDrag = 0.05f;
#endif
        rb.sleepThreshold = 0f;

        // Allow turning around Y, but prevent the slime from tipping over.
        rb.constraints = RigidbodyConstraints.FreezeRotationX |
                         RigidbodyConstraints.FreezeRotationZ;
        rb.collisionDetectionMode = CollisionDetectionMode.ContinuousDynamic;
        rb.interpolation = RigidbodyInterpolation.Interpolate;
        rb.WakeUp();

        startPosition = rb.position;
        startRotation = rb.rotation;

        // Animator root motion must not override Rigidbody movement.
        Animator[] animators = GetComponentsInChildren<Animator>(true);
        foreach (Animator animator in animators)
        {
            if (animator != null)
            {
                animator.applyRootMotion = false;
            }
        }

        ConfigureCollidersAndMaterial();
    }

    private void ConfigureCollidersAndMaterial()
    {
        Collider[] colliders = GetComponentsInChildren<Collider>(true);
        bool hasUsableCollider = false;

        foreach (Collider currentCollider in colliders)
        {
            if (IsUsableSlimeCollider(currentCollider))
            {
                hasUsableCollider = true;
                break;
            }
        }

        // Add a fallback collider if the Rigidbody has no active solid collider.
        if (!hasUsableCollider)
        {
            SphereCollider sphere = GetComponent<SphereCollider>();
            if (sphere == null)
            {
                sphere = gameObject.AddComponent<SphereCollider>();
            }

            sphere.enabled = true;
            sphere.isTrigger = false;
            if (sphere.radius <= 0f)
            {
                sphere.radius = 0.5f;
            }
        }

        // The material itself has zero bounce. All visible bounce is calculated below.
        runtimePhysicsMaterial = new SlimePhysicsMaterial("Slime_NoPhysicsBounce");
        runtimePhysicsMaterial.bounciness = 0f;
        runtimePhysicsMaterial.dynamicFriction = 0f;
        runtimePhysicsMaterial.staticFriction = 0f;
        runtimePhysicsMaterial.bounceCombine = SlimePhysicsMaterialCombine.Minimum;
        runtimePhysicsMaterial.frictionCombine = SlimePhysicsMaterialCombine.Minimum;

        colliders = GetComponentsInChildren<Collider>(true);
        float largestBoundsVolume = -1f;

        // Prefer the root collider; otherwise use the largest usable child collider.
        Collider rootCollider = GetComponent<Collider>();
        if (IsUsableSlimeCollider(rootCollider))
        {
            groundCheckCollider = rootCollider;
        }

        foreach (Collider currentCollider in colliders)
        {
            if (currentCollider == null || currentCollider.attachedRigidbody != rb)
            {
                continue;
            }

            if (currentCollider is MeshCollider meshCollider && !meshCollider.convex)
            {
                meshCollider.convex = true;
            }

            currentCollider.sharedMaterial = runtimePhysicsMaterial;

            if (!IsUsableSlimeCollider(currentCollider) || groundCheckCollider != null)
            {
                continue;
            }

            Vector3 size = currentCollider.bounds.size;
            float boundsVolume = size.x * size.y * size.z;
            if (boundsVolume > largestBoundsVolume)
            {
                largestBoundsVolume = boundsVolume;
                groundCheckCollider = currentCollider;
            }
        }

        if (groundCheckCollider == null)
        {
            Debug.LogError(
                "SlimeLauncher: Nebyl nalezen aktivni pevny Collider pripojeny k tomuto Rigidbody.",
                this
            );
        }
    }

    private bool IsUsableSlimeCollider(Collider candidate)
    {
        return candidate != null &&
               candidate.enabled &&
               candidate.gameObject.activeInHierarchy &&
               !candidate.isTrigger &&
               candidate.attachedRigidbody == rb;
    }

    private void Update()
    {
        Keyboard keyboard = Keyboard.current;
        if (keyboard == null)
        {
            moveDirection = Vector3.zero;
            charging = false;
            charge = 0f;
            return;
        }

        if (mainCamera == null)
        {
            mainCamera = Camera.main;
        }

        Vector3 forward = Vector3.forward;
        Vector3 right = Vector3.right;

        if (mainCamera != null)
        {
            Vector3 projectedForward = Vector3.ProjectOnPlane(
                mainCamera.transform.forward,
                Vector3.up
            );

            if (projectedForward.sqrMagnitude > 0.0001f)
            {
                forward = projectedForward.normalized;
                right = Vector3.Cross(Vector3.up, forward).normalized;
            }
        }

        float forwardInput = (keyboard.wKey.isPressed ? 1f : 0f) -
                             (keyboard.sKey.isPressed ? 1f : 0f);
        float rightInput = (keyboard.dKey.isPressed ? 1f : 0f) -
                           (keyboard.aKey.isPressed ? 1f : 0f);

        moveDirection = (forward * forwardInput + right * rightInput).normalized;

        // Begin charging only when standing on a surface.
        if (keyboard.spaceKey.wasPressedThisFrame && !charging && IsGrounded())
        {
            charging = true;
            charge = 0f;
        }

        if (charging)
        {
            if (keyboard.spaceKey.isPressed)
            {
                float safeChargeTime = Mathf.Max(0.01f, chargeTime);
                charge = Mathf.Clamp01(charge + Time.deltaTime / safeChargeTime);
            }
            else
            {
                pendingJump = Mathf.Max(0f, jumpPower) *
                              Mathf.Max(charge, Mathf.Clamp01(minimumJumpCharge));
                charging = false;
            }
        }
    }

    private void FixedUpdate()
    {
        Vector3 position = rb.position;
        Vector3 currentVelocity = LinearVelocity;

        bool invalidPosition = IsInvalid(position.x) ||
                               IsInvalid(position.y) ||
                               IsInvalid(position.z);
        bool invalidVelocity = IsInvalid(currentVelocity.x) ||
                               IsInvalid(currentVelocity.y) ||
                               IsInvalid(currentVelocity.z);

        if (position.y < fallLimit || invalidPosition || invalidVelocity)
        {
            ResetToStart();
            return;
        }

        if (bounceControlLockTimer > 0f)
        {
            bounceControlLockTimer = Mathf.Max(
                0f,
                bounceControlLockTimer - Time.fixedDeltaTime
            );
        }

        // A charged jump is accepted only if the slime is still grounded on release.
        if (pendingJump > 0f)
        {
            if (IsGrounded())
            {
                currentVelocity.y = pendingJump;
            }
            pendingJump = 0f;
        }

        Vector3 horizontalVelocity = new Vector3(
            currentVelocity.x,
            0f,
            currentVelocity.z
        );

        // Do not overwrite the rebound immediately with the WASD target velocity.
        if (bounceControlLockTimer <= 0f)
        {
            Vector3 targetVelocity = moveDirection * Mathf.Max(0f, moveSpeed);
            horizontalVelocity = Vector3.MoveTowards(
                horizontalVelocity,
                targetVelocity,
                Mathf.Max(0f, acceleration) * Time.fixedDeltaTime
            );
        }

        float safeMaximumFallSpeed = Mathf.Max(0.01f, maximumFallSpeed);
        currentVelocity = new Vector3(
            horizontalVelocity.x,
            Mathf.Max(currentVelocity.y, -safeMaximumFallSpeed),
            horizontalVelocity.z
        );

        LinearVelocity = currentVelocity;

        if (moveDirection.sqrMagnitude > 0.001f)
        {
            Quaternion targetRotation = Quaternion.LookRotation(moveDirection, Vector3.up);
            Quaternion nextRotation = Quaternion.RotateTowards(
                rb.rotation,
                targetRotation,
                Mathf.Max(1f, rotationSpeed) * Time.fixedDeltaTime
            );
            rb.MoveRotation(nextRotation);
        }

        // Save velocity immediately before the physics simulation step.
        lastVelocity = LinearVelocity;
    }

    private bool IsGrounded()
    {
        if (!IsUsableSlimeCollider(groundCheckCollider))
        {
            return false;
        }

        if (LinearVelocity.y > 0.5f)
        {
            return false;
        }

        Bounds bounds = groundCheckCollider.bounds;
        float rayDistance = bounds.extents.y + 0.2f;

        RaycastHit[] hits = Physics.RaycastAll(
            bounds.center,
            Vector3.down,
            rayDistance,
            Physics.AllLayers,
            QueryTriggerInteraction.Ignore
        );

        foreach (RaycastHit hit in hits)
        {
            if (hit.collider != null && hit.collider.attachedRigidbody != rb)
            {
                return true;
            }
        }

        return false;
    }

    private void OnCollisionEnter(Collision collision)
    {
        if (collision == null || collision.contactCount == 0 || collision.collider == null)
        {
            return;
        }

        if (collision.collider.attachedRigidbody == rb)
        {
            return;
        }

        Vector3 incomingVelocity = lastVelocity;
        if (IsInvalid(incomingVelocity.x) ||
            IsInvalid(incomingVelocity.y) ||
            IsInvalid(incomingVelocity.z) ||
            incomingVelocity.sqrMagnitude < 0.0001f)
        {
            return;
        }

        // Select the contact normal with the strongest approach speed.
        Vector3 bestNormal = Vector3.zero;
        float strongestApproachSpeed = 0f;

        for (int i = 0; i < collision.contactCount; i++)
        {
            Vector3 normal = collision.GetContact(i).normal.normalized;
            if (normal.sqrMagnitude < 0.0001f)
            {
                continue;
            }

            float approachSpeed = -Vector3.Dot(incomingVelocity, normal);
            if (approachSpeed < 0f)
            {
                normal = -normal;
                approachSpeed = -approachSpeed;
            }

            if (approachSpeed > strongestApproachSpeed)
            {
                strongestApproachSpeed = approachSpeed;
                bestNormal = normal;
            }
        }

        if (bestNormal.sqrMagnitude < 0.0001f)
        {
            return;
        }

        float retention = Mathf.Clamp01(bounciness);
        Vector3 reflectedVelocity;

        // FLOOR: reflect the full velocity vector, then retain exactly 75% by default.
        if (bestNormal.y > 0.55f)
        {
            if (strongestApproachSpeed < Mathf.Max(0f, minimumFloorImpactSpeed))
            {
                return;
            }

            reflectedVelocity = Vector3.Reflect(incomingVelocity, bestNormal) * retention;
            LinearVelocity = reflectedVelocity;
            bounceControlLockTimer = Mathf.Max(0f, bounceControlLock);
            return;
        }

        // CEILING: do not create an upward bounce from the underside of a surface.
        if (bestNormal.y < -0.55f)
        {
            return;
        }

        // WALL: reflect the full velocity vector. This reverses motion into the wall.
        if (strongestApproachSpeed < Mathf.Max(0f, minimumWallImpactSpeed))
        {
            return;
        }

        reflectedVelocity = Vector3.Reflect(incomingVelocity, bestNormal) * retention;
        LinearVelocity = reflectedVelocity;
        bounceControlLockTimer = Mathf.Max(0f, bounceControlLock);
    }

    private void ResetToStart()
    {
        rb.position = startPosition;
        rb.rotation = startRotation;
        LinearVelocity = Vector3.zero;
        rb.angularVelocity = Vector3.zero;
        rb.WakeUp();

        moveDirection = Vector3.zero;
        lastVelocity = Vector3.zero;
        pendingJump = 0f;
        charge = 0f;
        charging = false;
        bounceControlLockTimer = 0f;
    }

    private void OnDestroy()
    {
        if (runtimePhysicsMaterial != null)
        {
            Destroy(runtimePhysicsMaterial);
            runtimePhysicsMaterial = null;
        }
    }

    private void OnValidate()
    {
        moveSpeed = Mathf.Max(0f, moveSpeed);
        acceleration = Mathf.Max(0f, acceleration);
        rotationSpeed = Mathf.Max(1f, rotationSpeed);
        jumpPower = Mathf.Max(0f, jumpPower);
        chargeTime = Mathf.Max(0.01f, chargeTime);
        minimumJumpCharge = Mathf.Clamp01(minimumJumpCharge);
        bounciness = Mathf.Clamp01(bounciness);
        minimumFloorImpactSpeed = Mathf.Max(0f, minimumFloorImpactSpeed);
        minimumWallImpactSpeed = Mathf.Max(0f, minimumWallImpactSpeed);
        bounceControlLock = Mathf.Max(0f, bounceControlLock);
        maximumFallSpeed = Mathf.Max(0.01f, maximumFallSpeed);
    }

    private static bool IsInvalid(float value)
    {
        return float.IsNaN(value) || float.IsInfinity(value);
    }
}
