using TMPro;
using UnityEngine;
using UnityEngine.EventSystems;
using UnityEngine.UI;

#if ENABLE_INPUT_SYSTEM
using UnityEngine.InputSystem.UI;
#endif

[DisallowMultipleComponent]
public class MainMenu : MonoBehaviour
{
    [Header("Gameplay & Assets")]
    [SerializeField] private GameObject[] gameplayObjects;
    [SerializeField] private Sprite slimeSprite;
    [SerializeField] private Sprite menuBackground;
    [SerializeField] private TMP_FontAsset font;

    [Header("Styling")]
    [SerializeField] private Color titleColor = new Color32(181, 200, 57, 255);
    [SerializeField] private Color buttonColor = new Color32(181, 200, 57, 255);
    [SerializeField] private Color textColor = Color.black;
    [SerializeField, Min(1f)] private float titleFontSize = 150f;
    [SerializeField, Min(1f)] private float buttonFontSize = 70f;
    [SerializeField, Min(1f)] private float infoTitleFontSize = 110f;
    [SerializeField, Min(1f)] private float infoBodyFontSize = 60f;

    [Header("Options Settings")]
    [SerializeField, Range(40f, 110f)] private float defaultFOV = 60f;

    private Canvas menuCanvas;
    private GameObject menuRoot;
    private GameObject infoRoot;
    private GameObject optionsRoot;
    private TMP_Text infoTitle;
    private TMP_Text infoBody;

    private Sprite roundedSprite;
    private Texture2D roundedTexture;
    private Sprite generatedSlimeSprite;
    private Texture2D generatedSlimeTexture;

    private void Awake()
    {
        if (gameplayObjects == null)
            return;

        foreach (GameObject gameplayObject in gameplayObjects)
        {
            if (gameplayObject != null)
                gameplayObject.SetActive(false);
        }
    }

    private void Start()
    {
        SetupCamera();
        SetupEventSystem();

        menuCanvas = CreateCanvas();
        roundedSprite = CreateRoundedSprite();

        if (menuBackground == null && slimeSprite == null)
        {
            generatedSlimeSprite = CreateSlimeSprite();
        }

        BuildMenu(menuCanvas.transform);
        BuildInfoPanel(menuCanvas.transform);
        BuildOptionsPanel(menuCanvas.transform);
        ShowMenu();
    }

    private void OnDestroy()
    {
        if (roundedSprite != null) Destroy(roundedSprite);
        if (roundedTexture != null) Destroy(roundedTexture);
        if (generatedSlimeSprite != null) Destroy(generatedSlimeSprite);
        if (generatedSlimeTexture != null) Destroy(generatedSlimeTexture);
    }

    private void OnPlay()
    {
        if (gameplayObjects != null)
        {
            foreach (GameObject gameplayObject in gameplayObjects)
            {
                if (gameplayObject != null)
                    gameplayObject.SetActive(true);
            }
        }

        if (menuCanvas != null)
            menuCanvas.gameObject.SetActive(false);
    }

    private void OnOption()
    {
        ShowOptions();
    }

    private void OnSkins()
    {
        ShowInfo("Skins", "Tady budou skiny slimáka.");
    }

    private void ShowMenu()
    {
        if (menuRoot != null) menuRoot.SetActive(true);
        if (infoRoot != null) infoRoot.SetActive(false);
        if (optionsRoot != null) optionsRoot.SetActive(false);
    }

    private void ShowOptions()
    {
        if (menuRoot != null) menuRoot.SetActive(false);
        if (infoRoot != null) infoRoot.SetActive(false);
        if (optionsRoot != null) optionsRoot.SetActive(true);
    }

    private void ShowInfo(string title, string body)
    {
        if (infoTitle != null) infoTitle.text = title;
        if (infoBody != null) infoBody.text = body;

        if (menuRoot != null) menuRoot.SetActive(false);
        if (optionsRoot != null) optionsRoot.SetActive(false);
        if (infoRoot != null) infoRoot.SetActive(true);
    }

    private void BuildMenu(Transform parent)
    {
        menuRoot = CreateRect("MenuRoot", parent).gameObject;
        Stretch(menuRoot.GetComponent<RectTransform>());

        if (menuBackground != null)
        {
            RectTransform artworkRect = CreateRect("MenuArtwork", menuRoot.transform);
            Stretch(artworkRect);

            Image artwork = artworkRect.gameObject.AddComponent<Image>();
            artwork.sprite = menuBackground;
            artwork.preserveAspect = false;
            artwork.color = Color.white;
            artwork.raycastTarget = false;

            CreateInvisibleButton(menuRoot.transform, "PlayHitbox", 0.29f, 0.40f, 0.71f, 0.52f, OnPlay);
            CreateInvisibleButton(menuRoot.transform, "OptionHitbox", 0.29f, 0.26f, 0.71f, 0.38f, OnOption);
            CreateInvisibleButton(menuRoot.transform, "SkinsHitbox", 0.29f, 0.115f, 0.71f, 0.235f, OnSkins);
            return;
        }

        RectTransform title = CreateRect("Title", menuRoot.transform);
        SetAnchors(title, 0.25f, 0.62f, 0.75f, 0.98f);

        TMP_Text titleText = AddText(title.gameObject, "Slime\nGame", titleFontSize, titleColor);
        titleText.alignment = TextAlignmentOptions.Center;

        CreateSlime(menuRoot.transform, 0.13f);
        CreateSlime(menuRoot.transform, 0.87f);

        CreateButton(menuRoot.transform, "Play", 0.415f, 0.526f, OnPlay);
        CreateButton(menuRoot.transform, "Option", 0.266f, 0.377f, OnOption);
        CreateButton(menuRoot.transform, "Skins", 0.118f, 0.228f, OnSkins);
    }

    private void BuildInfoPanel(Transform parent)
    {
        infoRoot = CreateRect("InfoRoot", parent).gameObject;
        Stretch(infoRoot.GetComponent<RectTransform>());

        RectTransform title = CreateRect("InfoTitle", infoRoot.transform);
        SetAnchors(title, 0.2f, 0.7f, 0.8f, 0.95f);
        infoTitle = AddText(title.gameObject, "", infoTitleFontSize, titleColor);
        infoTitle.alignment = TextAlignmentOptions.Center;

        RectTransform body = CreateRect("InfoBody", infoRoot.transform);
        SetAnchors(body, 0.2f, 0.4f, 0.8f, 0.68f);
        infoBody = AddText(body.gameObject, "", infoBodyFontSize, Color.white);
        infoBody.alignment = TextAlignmentOptions.Center;

        CreateButton(infoRoot.transform, "Back", 0.15f, 0.26f, ShowMenu);
    }

    private void BuildOptionsPanel(Transform parent)
    {
        optionsRoot = CreateRect("OptionsRoot", parent).gameObject;
        Stretch(optionsRoot.GetComponent<RectTransform>());

        RectTransform titleRect = CreateRect("OptionsTitle", optionsRoot.transform);
        SetAnchors(titleRect, 0.2f, 0.75f, 0.8f, 0.95f);
        TMP_Text optTitle = AddText(titleRect.gameObject, "Options", infoTitleFontSize, titleColor);
        optTitle.alignment = TextAlignmentOptions.Center;

        RectTransform labelRect = CreateRect("FOVLabel", optionsRoot.transform);
        SetAnchors(labelRect, 0.3f, 0.55f, 0.7f, 0.65f);
        TMP_Text fovLabelText = AddText(labelRect.gameObject, "Camera FOV", 50f, Color.white);
        fovLabelText.alignment = TextAlignmentOptions.Center;

        RectTransform sliderRect = CreateRect("FOVSlider", optionsRoot.transform);
        SetAnchors(sliderRect, 0.3f, 0.45f, 0.7f, 0.52f);

        Slider slider = sliderRect.gameObject.AddComponent<Slider>();
        slider.minValue = 40f;
        slider.maxValue = 100f;
        
        Camera mainCam = Camera.main;
        if (mainCam != null)
        {
            slider.value = mainCam.fieldOfView;
        }
        else
        {
            slider.value = defaultFOV;
        }

        RectTransform bgRect = CreateRect("Background", sliderRect);
        SetAnchors(bgRect, 0f, 0.25f, 1f, 0.75f);
        Image bgImage = bgRect.gameObject.AddComponent<Image>();
        bgImage.color = new Color(0.2f, 0.2f, 0.2f, 1f);

        RectTransform fillAreaRect = CreateRect("Fill Area", sliderRect);
        SetAnchors(fillAreaRect, 0f, 0.25f, 1f, 0.75f);
        
        RectTransform fillRect = CreateRect("Fill", fillAreaRect);
        SetAnchors(fillRect, 0f, 0f, 0f, 1f);
        Image fillImage = fillRect.gameObject.AddComponent<Image>();
        fillImage.color = buttonColor;
        slider.fillRect = fillRect;

        RectTransform handleAreaRect = CreateRect("Handle Slide Area", sliderRect);
        SetAnchors(handleAreaRect, 0f, 0f, 1f, 1f);

        RectTransform handleRect = CreateRect("Handle", handleAreaRect);
        SetAnchors(handleRect, 0f, 0f, 0f, 1f);
        handleRect.sizeDelta = new Vector2(40f, 0f);
        Image handleImage = handleRect.gameObject.AddComponent<Image>();
        handleImage.sprite = roundedSprite;
        handleImage.color = Color.white;
        slider.handleRect = handleRect;

        slider.onValueChanged.AddListener(val => {
            if (Camera.main != null)
            {
                Camera.main.fieldOfView = val;
            }
        });

        CreateButton(optionsRoot.transform, "Back", 0.15f, 0.26f, ShowMenu);
    }

    private void CreateButton(
        Transform parent,
        string label,
        float yMin,
        float yMax,
        UnityEngine.Events.UnityAction onClick)
    {
        RectTransform buttonRect = CreateRect(label + "Button", parent);
        SetAnchors(buttonRect, 0.231f, yMin, 0.768f, yMax);

        Image image = buttonRect.gameObject.AddComponent<Image>();
        image.sprite = roundedSprite;
        image.type = Image.Type.Sliced;
        image.color = Color.white;
        image.raycastTarget = true;

        Button button = buttonRect.gameObject.AddComponent<Button>();
        button.targetGraphic = image;
        button.onClick.AddListener(onClick);

        ColorBlock colors = button.colors;
        colors.normalColor = buttonColor;
        colors.highlightedColor = Color.Lerp(buttonColor, Color.white, 0.25f);
        colors.pressedColor = Color.Lerp(buttonColor, Color.black, 0.25f);
        colors.selectedColor = buttonColor;
        colors.disabledColor = new Color(buttonColor.r, buttonColor.g, buttonColor.b, 0.5f);
        colors.fadeDuration = 0.08f;
        button.colors = colors;

        RectTransform labelRect = CreateRect("Label", buttonRect);
        Stretch(labelRect);

        TMP_Text labelText = AddText(labelRect.gameObject, label, buttonFontSize, textColor);
        labelText.alignment = TextAlignmentOptions.Center;
        labelText.raycastTarget = false;
        labelText.enableWordWrapping = true;
    }

    private void CreateInvisibleButton(
        Transform parent,
        string objectName,
        float xMin,
        float yMin,
        float xMax,
        float yMax,
        UnityEngine.Events.UnityAction onClick)
    {
        RectTransform rect = CreateRect(objectName, parent);
        SetAnchors(rect, xMin, yMin, xMax, yMax);

        Image image = rect.gameObject.AddComponent<Image>();
        image.color = new Color(1f, 1f, 1f, 0f);
        image.raycastTarget = true;

        Button button = rect.gameObject.AddComponent<Button>();
        button.targetGraphic = image;
        button.transition = Selectable.Transition.None;
        button.onClick.AddListener(onClick);
    }

    private void CreateSlime(Transform parent, float xAnchor)
    {
        RectTransform rect = CreateRect("Slime", parent);
        rect.anchorMin = new Vector2(xAnchor, 0.79f);
        rect.anchorMax = new Vector2(xAnchor, 0.79f);
        rect.pivot = new Vector2(0.5f, 0.5f);
        rect.sizeDelta = new Vector2(280f, 230f);
        rect.anchoredPosition = Vector2.zero;

        Image image = rect.gameObject.AddComponent<Image>();
        image.sprite = slimeSprite != null ? slimeSprite : generatedSlimeSprite;
        image.preserveAspect = true;
        image.raycastTarget = false;
        image.color = Color.white;
    }

    private void SetupCamera()
    {
        Camera cameraToUse = Camera.main;
        if (cameraToUse == null)
        {
            cameraToUse = FindObjectOfType<Camera>();
        }
        if (cameraToUse == null)
        {
            GameObject cameraObject = new GameObject("Main Camera");
            cameraToUse = cameraObject.AddComponent<Camera>();
            cameraObject.tag = "MainCamera";
        }
        else if (!cameraToUse.CompareTag("MainCamera"))
        {
            cameraToUse.tag = "MainCamera";
        }

        cameraToUse.clearFlags = CameraClearFlags.SolidColor;
        cameraToUse.backgroundColor = Color.black;
    }

    private void SetupEventSystem()
    {
        EventSystem eventSystem = FindObjectOfType<EventSystem>();
        if (eventSystem == null)
        {
            GameObject eventSystemObject = new GameObject("EventSystem");
            eventSystem = eventSystemObject.AddComponent<EventSystem>();
        }

#if ENABLE_INPUT_SYSTEM
        StandaloneInputModule oldModule = eventSystem.GetComponent<StandaloneInputModule>();
        if (oldModule != null)
        {
            oldModule.enabled = false;
            Destroy(oldModule);
        }

        if (eventSystem.GetComponent<InputSystemUIInputModule>() == null)
        {
            eventSystem.gameObject.AddComponent<InputSystemUIInputModule>();
        }
#else
        if (eventSystem.GetComponent<StandaloneInputModule>() == null)
        {
            eventSystem.gameObject.AddComponent<StandaloneInputModule>();
        }
#endif
    }

    private Canvas CreateCanvas()
    {
        GameObject canvasObject = new GameObject("MenuCanvas");
        Canvas canvas = canvasObject.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;

        CanvasScaler scaler = canvasObject.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920f, 1080f);
        scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
        scaler.matchWidthOrHeight = 0.5f;

        canvasObject.AddComponent<GraphicRaycaster>();

        RectTransform backgroundRect = CreateRect("Background", canvas.transform);
        Stretch(backgroundRect);

        Image background = backgroundRect.gameObject.AddComponent<Image>();
        background.color = Color.black;
        background.raycastTarget = false;

        return canvas;
    }

    private TMP_Text AddText(GameObject gameObject, string value, float size, Color color)
    {
        TextMeshProUGUI text = gameObject.AddComponent<TextMeshProUGUI>();
        if (font != null) text.font = font;

        text.text = value;
        text.fontSize = size;
        text.color = color;
        text.enableWordWrapping = true;
        text.raycastTarget = false;

        return text;
    }

    private static RectTransform CreateRect(string objectName, Transform parent)
    {
        GameObject gameObject = new GameObject(objectName, typeof(RectTransform));
        gameObject.transform.SetParent(parent, false);
        return gameObject.GetComponent<RectTransform>();
    }

    private static void Stretch(RectTransform rect)
    {
        rect.anchorMin = Vector2.zero;
        rect.anchorMax = Vector2.one;
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
    }

    private static void SetAnchors(
        RectTransform rect,
        float xMin,
        float yMin,
        float xMax,
        float yMax)
    {
        rect.anchorMin = new Vector2(xMin, yMin);
        rect.anchorMax = new Vector2(xMax, yMax);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
    }

    private Sprite CreateRoundedSprite()
    {
        const int size = 64;
        const float radius = 24f;

        roundedTexture = new Texture2D(size, size, TextureFormat.RGBA32, false);
        roundedTexture.name = "RuntimeRoundedButtonTexture";
        roundedTexture.filterMode = FilterMode.Bilinear;
        roundedTexture.wrapMode = TextureWrapMode.Clamp;

        for (int y = 0; y < size; y++)
        {
            for (int x = 0; x < size; x++)
            {
                float pixelX = x + 0.5f;
                float pixelY = y + 0.5f;

                float closestX = Mathf.Clamp(pixelX, radius, size - radius);
                float closestY = Mathf.Clamp(pixelY, radius, size - radius);
                float distance = Vector2.Distance(
                    new Vector2(pixelX, pixelY),
                    new Vector2(closestX, closestY));

                float alpha = Mathf.Clamp01(radius - distance + 0.5f);
                roundedTexture.SetPixel(x, y, new Color(1f, 1f, 1f, alpha));
            }
        }

        roundedTexture.Apply();

        return Sprite.Create(
            roundedTexture,
            new Rect(0f, 0f, size, size),
            new Vector2(0.5f, 0.5f),
            100f,
            0,
            SpriteMeshType.FullRect,
            new Vector4(radius, radius, radius, radius));
    }

    private Sprite CreateSlimeSprite()
    {
        const int width = 256;
        const int height = 200;

        generatedSlimeTexture = new Texture2D(width, height, TextureFormat.RGBA32, false);
        generatedSlimeTexture.name = "RuntimeSlimeTexture";
        generatedSlimeTexture.filterMode = FilterMode.Bilinear;
        generatedSlimeTexture.wrapMode = TextureWrapMode.Clamp;

        Color body = new Color32(190, 215, 50, 255);
        Color shade = new Color32(90, 125, 30, 255);
        Color eyeColor = new Color32(30, 40, 10, 255);
        Color cheekColor = new Color32(220, 80, 200, 255);

        for (int y = 0; y < height; y++)
        {
            for (int x = 0; x < width; x++)
            {
                float nx = (x - width / 2f) / (width / 2f);
                float ny = y / (height * 0.9f);
                float distance = nx * nx + ny * ny;

                if (distance > 1f || y < 6)
                {
                    generatedSlimeTexture.SetPixel(x, y, Color.clear);
                    continue;
                }

                Color pixelColor = Color.Lerp(
                    body,
                    shade,
                    Mathf.Clamp01((ny - 0.45f) * 1.6f));

                float highlightX = (x - width * 0.3f) / 22f;
                float highlightY = (y - height * 0.72f) / 14f;
                if (highlightX * highlightX + highlightY * highlightY < 1f)
                    pixelColor = Color.white;

                float eyeLeftX = (x - width * 0.33f) / 26f;
                float eyeRightX = (x - width * 0.67f) / 26f;
                float eyeY = (y - height * 0.35f) / 4f;

                if (eyeLeftX * eyeLeftX + eyeY * eyeY < 1f ||
                    eyeRightX * eyeRightX + eyeY * eyeY < 1f)
                {
                    pixelColor = eyeColor;
                }

                float cheekLeftX = (x - width * 0.24f) / 16f;
                float cheekRightX = (x - width * 0.76f) / 16f;
                float cheekY = (y - height * 0.27f) / 9f;

                if (cheekLeftX * cheekLeftX + cheekY * cheekY < 1f ||
                    cheekRightX * cheekRightX + cheekY * cheekY < 1f)
                {
                    pixelColor = cheekColor;
                }

                generatedSlimeTexture.SetPixel(x, y, pixelColor);
            }
        }

        generatedSlimeTexture.Apply();

        return Sprite.Create(
            generatedSlimeTexture,
            new Rect(0f, 0f, width, height),
            new Vector2(0.5f, 0.5f),
            100f);
    }
}
